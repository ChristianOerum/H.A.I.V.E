[Unit]
Description=HAIVE Chromium kiosk
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set to the desktop login user (e.g. pi). Overridable via drop-in.
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# Address of the HAIVE add-on running on your Home Assistant machine.
Environment=HAIVE_URL=http://homeassistant.local:3000/?kiosk=1
ExecStart=/opt/haive/deploy/kiosk-launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
